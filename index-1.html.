<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#10131b"><meta name="description" content="Grand Slam Fantasy 2026 — league table, team selections, rules and scoring."><title>Grand Slam Fantasy 2026 | League & Rules</title>
<style>
:root{color-scheme:dark;--bg:#0b0e14;--surface:#161b25;--surface2:#1e2531;--line:#303847;--text:#f6f5ef;--muted:#aeb7c4;--gold:#f4c95d;--green:#6ce5b1}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.55 system-ui,-apple-system,Segoe UI,sans-serif}button{font:inherit}a{color:inherit;text-decoration:none}.wrap{width:min(1050px,calc(100% - 36px));margin:auto}.top{border-bottom:1px solid var(--line);background:#11151d}.top .wrap{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px 0}.brand{font-weight:900;letter-spacing:.04em;font-size:14px}.brand b{color:var(--gold)}.top nav{display:flex;gap:17px;font-size:13px;color:#c7cfda}.top nav a:hover{color:var(--gold)}.hero{position:relative;overflow:hidden;padding:65px 0 58px;background:radial-gradient(ellipse at 85% 20%,#3b3023 0,transparent 42%),linear-gradient(125deg,#171d28,#0c1017 70%);border-bottom:1px solid var(--line)}.eyebrow{font-size:12px;letter-spacing:.19em;font-weight:900;color:var(--gold);text-transform:uppercase}.hero h1{font-size:clamp(42px,8vw,80px);letter-spacing:-.065em;line-height:.98;margin:16px 0 22px;max-width:750px}.hero h1 span{color:var(--gold)}.hero p{max-width:570px;color:#c7cfda;margin:0 0 25px}.chips{display:flex;gap:9px;flex-wrap:wrap}.chip{border:1px solid #5b5543;border-radius:100px;padding:7px 13px;font-size:13px;background:#24251f}.cta{display:inline-block;background:var(--gold);color:#161512;border-radius:9px;padding:11px 17px;font-weight:800;margin-top:25px}.section{padding:48px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:20px}.section-head h2{margin:0;font-size:clamp(26px,5vw,37px);letter-spacing:-.035em}.section-head p{margin:5px 0 0;color:var(--muted)}.pill{display:inline-block;border:1px solid #415444;background:#203a31;color:#a6f2c9;padding:5px 10px;border-radius:100px;font-size:12px;font-weight:700}.panel{background:var(--surface);border:1px solid var(--line);border-radius:15px;overflow:hidden}.panel-pad{padding:23px}.board{width:100%;border-collapse:collapse}.board th{text-transform:uppercase;letter-spacing:.09em;font-size:11px;color:var(--muted);font-weight:800;text-align:left;background:#1b222e}.board th,.board td{padding:17px 19px;border-bottom:1px solid var(--line)}.board tr:last-child td{border-bottom:0}.board td:last-child,.board th:last-child{text-align:right}.board .rank{font-weight:900;color:var(--gold)}.team-button{border:0;background:transparent;color:var(--text);cursor:pointer;padding:0;text-align:left;font-weight:750}.team-button:hover{text-decoration:underline;color:var(--gold)}.sub{color:var(--muted);font-size:13px}.empty{text-align:center;padding:38px 20px;color:var(--muted)}.empty strong{display:block;color:var(--text);font-size:18px;margin-bottom:5px}.two{display:grid;grid-template-columns:1.15fr .85fr;gap:20px}.detail-title{font-size:23px;margin:0 0 4px}.detail-list{list-style:none;margin:16px 0 0;padding:0}.detail-list li{display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-top:1px solid var(--line)}.captain{font-size:11px;background:#5b4422;color:#ffe0a0;padding:3px 7px;border-radius:5px;font-weight:800;margin-left:7px}.rules-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.rule{background:var(--surface);border:1px solid var(--line);padding:22px;border-radius:13px}.rule .num{color:var(--gold);font-size:13px;font-weight:900}.rule h3{margin:8px 0;font-size:18px}.rule p{margin:0;color:var(--muted);font-size:14px}.scoring{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.score{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid var(--line);border-radius:10px;background:var(--surface);padding:15px 17px}.score b{font-size:20px;color:var(--gold);white-space:nowrap}.note{border-left:3px solid var(--gold);padding:12px 15px;background:#29261e;color:#e9dcc1;border-radius:0 8px 8px 0;margin-top:18px;font-size:14px}.footer{border-top:1px solid var(--line);padding:24px 0;color:var(--muted);font-size:13px}.footer .wrap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.mini{font-size:12px;color:var(--muted)}@media(max-width:700px){.top .wrap{align-items:flex-start;flex-direction:column}.hero{padding:45px 0}.two,.rules-grid,.scoring{grid-template-columns:1fr}.section{padding:34px 0}.board th,.board td{padding:13px 11px}.section-head{align-items:start;flex-direction:column}.brand{font-size:13px}}
.stat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:20px 0}.stat-card{background:#202734;border:1px solid var(--line);border-radius:12px;padding:15px}.stat-card .value{font-size:25px;font-weight:900;color:var(--gold);line-height:1.2}.stat-card .label{font-size:12px;color:var(--muted);margin-top:5px}.detail-table-wrap{overflow-x:auto;margin-top:14px}.detail-table{width:100%;border-collapse:collapse;min-width:610px}.detail-table th,.detail-table td{padding:11px 10px;border-bottom:1px solid var(--line);text-align:right;font-size:13px}.detail-table th:first-child,.detail-table td:first-child{text-align:left}.detail-table th{font-size:11px;color:var(--muted);text-transform:uppercase}.breakdown{margin-top:16px;border-top:1px solid var(--line);padding-top:15px}.breakdown h4{margin:0 0 9px}.breakdown-line{display:flex;justify-content:space-between;gap:15px;padding:6px 0;color:var(--muted)}.breakdown-line strong{color:var(--text)}.stats-note{color:var(--muted);font-size:12px;margin-top:13px}@media(max-width:700px){.stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stat-card{padding:12px}.stat-card .value{font-size:22px}}</style></head><body>
<div class="top"><div class="wrap"><a href="#home" class="brand">🎯 GRAND SLAM <b>FANTASY</b></a><nav aria-label="Main navigation"><a href="#leaderboard">Leaderboard</a><a href="#teams">Teams</a><a href="#rules">Rules</a><a href="#scoring">Scoring</a></nav></div></div>
<header id="home" class="hero"><div class="wrap"><div class="eyebrow">The 2026 fantasy darts challenge</div><h1>Pick your six.<br><span>Chase the glory.</span></h1><p>Six darts stars. One captain. A £100 million budget. Follow every team, track the points and see who comes out on top.</p><div class="chips"><span class="chip">🎯 6 players</span><span class="chip">💰 £100m budget</span><span class="chip">👑 2× captain points</span><span class="chip">🔒 Locked teams</span></div><a class="cta" href="#leaderboard">View leaderboard ↓</a></div></header>
<main><section class="section" id="leaderboard"><div class="wrap"><div class="section-head"><div><div class="eyebrow">The race is on</div><h2>League leaderboard</h2><p id="status">Loading published league data…</p></div><span class="pill">PUBLIC LEAGUE</span></div><div class="panel"><table class="board"><thead><tr><th>Rank</th><th>Fantasy team</th><th>Points</th></tr></thead><tbody id="board"><tr><td colspan="3" class="empty">Loading teams…</td></tr></tbody></table></div><p class="mini" id="refresh-note">Scores reflect the most recently published results.</p></div></section>
<section class="section" id="teams" style="padding-top:0"><div class="wrap"><div class="section-head"><div><div class="eyebrow">See the selections</div><h2>Team breakdown & statistics</h2><p>Tap a team to see its six picks, captain, 180s, checkouts and full fantasy points breakdown.</p></div></div><div class="panel panel-pad" id="detail"><div class="empty"><strong>No team selected yet</strong>Choose a team above to view its players and points.</div></div></div></section>
<section class="section" id="rules" style="background:#10151d;border-top:1px solid var(--line)"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Know the game</div><h2>Competition rules</h2><p>Simple to enter. Difficult to win.</p></div></div><div class="rules-grid"><div class="rule"><div class="num">01 / THE SQUAD</div><h3>Pick six players</h3><p>Choose six different darts players from the competition's published player list.</p></div><div class="rule"><div class="num">02 / THE BUDGET</div><h3>Stay under £100m</h3><p>Your six players must cost no more than £100 million combined, using the fantasy price list.</p></div><div class="rule"><div class="num">03 / THE CAPTAIN</div><h3>Choose your captain</h3><p>Nominate one of your six players. All fantasy points earned by your captain count double.</p></div><div class="rule"><div class="num">04 / SUBMISSION</div><h3>Send picks to the organiser</h3><p>The organiser enters teams. Once a team has been submitted and locked, no changes or transfers are allowed.</p></div><div class="rule"><div class="num">05 / THE LEAGUE</div><h3>Highest points wins</h3><p>Teams are ranked by total fantasy points earned across the tournament.</p></div><div class="rule"><div class="num">06 / TRANSPARENCY</div><h3>Everyone can follow</h3><p>All published teams, captain choices and league standings are visible to visitors.</p></div></div></div></section>
<section class="section" id="scoring"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Every dart matters</div><h2>Fantasy points system</h2><p>Official competition scoring rules.</p></div></div><div class="scoring"><div class="score"><span>Win a group-stage match</span><b>+5</b></div><div class="score"><span>Each 180 scored</span><b>+2</b></div><div class="score"><span>Each checkout of 100 or more</span><b>+3</b></div><div class="score"><span>Match average of 100 or more</span><b>+5</b></div><div class="score"><span>Reach the last 16</span><b>+5</b></div><div class="score"><span>Reach the quarter-finals</span><b>+10</b></div><div class="score"><span>Reach the semi-finals</span><b>+15</b></div><div class="score"><span>Reach the final</span><b>+20</b></div><div class="score"><span>Win the tournament</span><b>+30</b></div><div class="score"><span>Captain bonus</span><b>2×</b></div></div><div class="note"><strong>Scoring note:</strong> These are the agreed fantasy points. The 100+ checkout rule requires match-by-match checkout data, not just the highest checkout. Live statistics will appear after the results feed is connected.</div></div></section></main>
<footer class="footer"><div class="wrap"><span>🎯 Grand Slam Fantasy 2026 · Organised for the darts crew</span><span>Public view only · Teams managed by the organiser</span></div></footer>
<script>
const DATA_URL='./data.json';
let selectedName=null,teams=[],data={};
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const number=v=>Number.isFinite(Number(v))&&v!==null&&v!==undefined&&v!==''?Number(v):null;
const fmt=v=>v===null?'—':String(v);
// Published playerStats are cumulative counts. Do not infer 100+ checkout counts from highest checkout.
// stageBonus is the SUM of awarded progression bonuses, not a stage index.
function playerStat(name){
 const s=data.playerStats?.[name];
 if(!s)return null;
 const fields=['groupWins','oneEighties','tonPlusCheckouts','hundredPlusAverages','stageBonus'];
 if(!fields.every(k=>number(s[k])!==null))return null;
 const groupWins=number(s.groupWins),oneEighties=number(s.oneEighties),tonPlusCheckouts=number(s.tonPlusCheckouts),hundredPlusAverages=number(s.hundredPlusAverages),stageBonus=number(s.stageBonus);
 const total=groupWins*5+oneEighties*2+tonPlusCheckouts*3+hundredPlusAverages*5+stageBonus;
 return {groupWins,oneEighties,tonPlusCheckouts,hundredPlusAverages,stageBonus,total};
}
function pointsFor(name){return playerStat(name)?.total??number(data.points?.[name])??0}
function teamStats(t){
 const picks=t.picks||[];
 if(!picks.length||!picks.every(p=>playerStat(p)))return null;
 const totals={groupWins:0,oneEighties:0,tonPlusCheckouts:0,hundredPlusAverages:0,stageBonus:0,groupPoints:0,oneEightyPoints:0,checkoutPoints:0,averagePoints:0,captainBonus:0};
 for(const p of picks){const s=playerStat(p);for(const k of ['groupWins','oneEighties','tonPlusCheckouts','hundredPlusAverages'])totals[k]+=s[k];totals.stageBonus+=s.stageBonus;totals.groupPoints+=s.groupWins*5;totals.oneEightyPoints+=s.oneEighties*2;totals.checkoutPoints+=s.tonPlusCheckouts*3;totals.averagePoints+=s.hundredPlusAverages*5;if(p===t.captain)totals.captainBonus+=s.total}
 return totals;
}
function statCard(label,value){return `<div class="stat-card"><div class="value">${fmt(value)}</div><div class="label">${label}</div></div>`}
function showTeam(t){
 selectedName=t.name;
 const stats=teamStats(t);
 const picks=(t.picks||[]).map(p=>{
  const s=playerStat(p),cap=p===t.captain,mult=cap?2:1;
  return `<tr><td><strong>${esc(p)}</strong>${cap?'<span class="captain">CAPTAIN ×2</span>':''}</td><td>${fmt(s?.oneEighties??null)}</td><td>${fmt(s?.tonPlusCheckouts??null)}</td><td>${fmt(s?.hundredPlusAverages??null)}</td><td>${fmt(s?.groupWins??null)}</td><td><strong>${pointsFor(p)*mult}</strong></td></tr>`;
 }).join('');
 const summary=`<div class="stat-grid">${statCard('Team 180s',stats?.oneEighties??null)}${statCard('100+ checkouts',stats?.tonPlusCheckouts??null)}${statCard('100+ average matches',stats?.hundredPlusAverages??null)}${statCard('Group wins',stats?.groupWins??null)}${statCard('Progression bonus pts',stats?.stageBonus??null)}${statCard('Fantasy points',t.points)}</div>`;
 const lines=stats?`<div class="breakdown"><h4>Where the points came from</h4>${[['Group-stage wins',stats.groupPoints],['180s',stats.oneEightyPoints],['100+ checkouts',stats.checkoutPoints],['100+ match averages',stats.averagePoints],['Tournament progression',stats.stageBonus],['Captain double-points bonus',stats.captainBonus]].map(([label,value])=>`<div class="breakdown-line"><span>${label}</span><strong>+${value}</strong></div>`).join('')}<div class="breakdown-line" style="border-top:1px solid var(--line);margin-top:7px;padding-top:12px"><strong>Total fantasy points</strong><strong>${t.points}</strong></div></div>`:'';
 document.getElementById('detail').innerHTML=`<h3 class="detail-title">${esc(t.name)}</h3><div class="sub">Manager: ${esc(t.manager||'Not specified')} · <strong>${t.points} pts</strong></div>${summary}<h4>Player-by-player performance</h4><div class="detail-table-wrap"><table class="detail-table"><thead><tr><th>Player</th><th>180s</th><th>100+ CO</th><th>100+ Avg</th><th>Wins</th><th>Points</th></tr></thead><tbody>${picks}</tbody></table></div>${lines}<p class="stats-note">180s, checkouts, averages and wins are raw team totals; captain multipliers apply to fantasy points only. ${stats?'Statistics are from the most recently published data.':'Detailed match statistics are awaiting publication. A dash (—) means no verified data, not zero.'}</p>`;
}
async function load(){try{
 const r=await fetch(DATA_URL+'?t='+Date.now(),{cache:'no-store'});if(!r.ok)throw Error('No data');data=await r.json();
 teams=(data.teams||[]).map(t=>({...t,points:(t.picks||[]).reduce((sum,p)=>sum+pointsFor(p)*(p===t.captain?2:1),0)})).sort((a,b)=>b.points-a.points);
 document.getElementById('status').textContent=`${teams.length} ${teams.length===1?'team':'teams'} entered · Last published: ${data.updated||'Not specified'}`;
 document.getElementById('board').innerHTML=teams.map((t,i)=>`<tr><td class="rank">${i+1}</td><td><button class="team-button" data-i="${i}">${esc(t.name)}</button><div class="sub">${esc(t.manager||'')}</div></td><td><strong>${t.points}</strong></td></tr>`).join('')||'<tr><td colspan="3"><div class="empty"><strong>Teams coming soon</strong>The organiser hasn’t published any teams yet. Check back once entries are in.</div></td></tr>';
 document.querySelectorAll('[data-i]').forEach(b=>b.addEventListener('click',()=>{showTeam(teams[Number(b.dataset.i)]);document.getElementById('teams').scrollIntoView({behavior:'smooth'})}));
 if(selectedName){const t=teams.find(x=>x.name===selectedName);if(t)showTeam(t)}
 }catch(e){document.getElementById('status').textContent='Waiting for published league data';document.getElementById('board').innerHTML='<tr><td colspan="3" class="empty">League data is not available yet.</td></tr>'}
}
load();setInterval(load,60000);
</script></body></html>
